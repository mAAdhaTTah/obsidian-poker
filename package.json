{
  "name": "obsidian-poker",
  "version": "1.2.3",
  "description": "Easily document and view your poker hands.",
  "main": "dist/main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "fix": "npm run fix:format && npm run fix:lint",
    "fix:format": "prettier --write {*.mjs,src/**/*.{ts,tsx}}",
    "fix:lint": "eslint --fix {*.mjs,src/**/*.{ts,tsx}}",
    "test": "npm run test:types && npm run test:format && npm run test:lint",
    "test:types": "tsc -noEmit -skipLibCheck",
    "test:format": "prettier --check {*.mjs,src/**/*.{ts,tsx}}",
    "test:lint": "eslint {*.mjs,src/**/*.{ts,tsx}}",
    "build": "node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@codemirror/language": "^6.8.0",
    "@types/node": "^16.11.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "builtin-modules": "3.3.0",
    "esbuild": "^0.28.2",
    "esbuild-plugin-copy": "^2.1.1",
    "esbuild-plugin-svg": "^0.1.0",
    "eslint": "^8.57.1",
    "obsidian": "latest",
    "prettier": "^2.8.8",
    "tslib": "^2.8.1",
    "typescript": "~6.0"
  },
  "dependencies": {
    "@spotlab/hand-matrix": "^0.3.0",
    "@spotlab/range": "^0.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
