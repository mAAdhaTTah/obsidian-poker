{
  "name": "obsidian-poker",
  "version": "1.4.1",
  "private": true,
  "description": "Easily document and view your poker hands.",
  "main": "dist/main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "fix": "npm run fix:format && npm run fix:lint",
    "fix:format": "prettier --write {*.mjs,scripts/*.mjs,src/**/*.{ts,tsx}}",
    "fix:lint": "eslint --fix .",
    "test": "npm run test:types && npm run test:format && npm run test:lint && npm run test:unit",
    "test:types": "tsc -noEmit -skipLibCheck",
    "test:format": "prettier --check {*.mjs,scripts/*.mjs,src/**/*.{ts,tsx}}",
    "test:lint": "eslint .",
    "test:unit": "vitest run",
    "build": "node esbuild.config.mjs production",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/version-bump.mjs && npm install --package-lock-only"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@codemirror/language": "^6.8.0",
    "@codemirror/state": "^6.2.1",
    "@codemirror/view": "^6.13.2",
    "@eslint/js": "^9.39.5",
    "@eslint/json": "^0.14.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "esbuild-plugin-copy": "^2.1.1",
    "esbuild-plugin-svg": "^0.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "globals": "^17.13.0",
    "obsidian": "^1.14.4",
    "prettier": "^2.8.8",
    "tslib": "^2.8.1",
    "typescript": "~6.0",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@spotlab/hand-matrix": "^0.5.0",
    "@spotlab/range": "^0.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
