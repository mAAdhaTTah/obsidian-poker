{
  "compilerOptions": {
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "ESNext",
    "target": "ES2020",
    "allowJs": true,
    "strict": false,
    "noImplicitAny": true,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "isolatedModules": true,
    "strictNullChecks": true,
    "types": ["node"],
    "lib": ["DOM", "DOM.Iterable", "ES2020"]
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "dist", "vault"]
}
